{
   "name": "bikeshop",
   "private": true,
   "workspaces": [
      "packages/shop",
      "packages/shop-ui"
   ],
   "scripts": {
      "start": "npm run build && concurrently 'npm run watch --workspaces' 'npm run start --workspace=@bikeshop/shop-ui'",
      "build": "npm run clean --workspaces --if-present && npm run build --workspaces --if-present",
      "clean": "npm run clean --workspaces --if-present",
      "test": "npm run test --workspaces --if-present -- --ci",
      "prettier": "prettier --write {**/*,*}.{json,ts,tsx}"
   },
   "prettier": {
      "tabWidth": 3,
      "semi": false,
      "singleQuote": false,
      "trailingComma": "es5"
   },
   "devDependencies": {
      "@types/jest": "^30.0.0",
      "concurrently": "^9.2.1",
      "jest": "^30.2.0",
      "postcss": "^8.5.6",
      "prettier": "^3.6.2",
      "rimraf": "5.0.5",
      "ts-jest": "^29.4.5",
      "typescript": "^5.9.3"
   },
   "engines": {
      "node": ">=25.1.0"
   }
}
